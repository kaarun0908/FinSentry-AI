# FinSentry AI Environment Configuration

# Optional LLM API Keys (Gemini, Anthropic, or OpenAI)
# If left blank, the app will run with the built-in deterministic heuristic rule engine.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Database URL
# Default SQLite (no setup required):
DATABASE_URL=sqlite:///./finsentry.db

# Or PostgreSQL with pgvector (via docker-compose up -d):
# DATABASE_URL=postgresql://finsentry:finsentry_secure_password@localhost:5432/finsentry_db
